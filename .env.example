# JuicySMS API key (account master key, or a scoped v2 key).
# Account -> API keys on https://juicysms.com
JUICYSMS_API_KEY=your_api_key_here

# Port the panel listens on
PORT=3200

# Panel login. REQUIRED whenever this is reachable from the internet — without
# PANEL_PASS the panel is completely open and anyone can spend your balance.
PANEL_USER=admin
PANEL_PASS=change-me-to-something-long

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# ---- Telegram bot (optional) ----
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram ids allowed to approve/deny access requests.
# Leave empty and the first person to /start claims ownership.
TELEGRAM_OWNER_ID=
# Unguessable secret for the webhook path and header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL Telegram should deliver updates to.
PUBLIC_URL=
