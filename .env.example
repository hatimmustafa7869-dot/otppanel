# smsotps.com API key (Profile -> API key)
SMSOTPS_API_KEY=your_api_key_here
# provider_a | provider_b | provider_d
SMSOTPS_PROVIDER=provider_a
SMSOTPS_DEFAULT_COUNTRY=united kingdom

# Port the panel listens on
PORT=3200

# Panel login. REQUIRED whenever this is reachable from the internet — without
# PANEL_PASS the panel is completely open and anyone can spend your balance.
PANEL_USER=admin
PANEL_PASS=change-me-to-something-long

# Signs the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=change-me

# ---- Telegram bot (optional) ----
# From @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram ids allowed to approve/deny access requests.
# Leave empty and the first person to /start claims ownership.
TELEGRAM_OWNER_ID=
# Unguessable secret for the webhook path and header. Generate with:
#   node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
TELEGRAM_WEBHOOK_SECRET=
# Public HTTPS base URL Telegram should deliver updates to.
PUBLIC_URL=
# Daily spend cap per approved (non-owner) user, in EUR. "none" = unlimited.
# Defaults to 5.00 when unset. Owners are never capped.
TELEGRAM_DEFAULT_DAILY_LIMIT=5.00

# ---- Durable storage ----
# Without one of these, bot state (approvals, balances, bans) lives in ./data
# and is DESTROYED by every deploy, because the deploy replaces the app folder.
#
# Option A (recommended): MySQL, created in hPanel -> Databases.
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=
MYSQL_PASSWORD=
MYSQL_DATABASE=
#
# Option B: keep JSON files, but somewhere a deploy does not overwrite.
# DATA_DIR=/home/USERNAME/otp-panel-data
